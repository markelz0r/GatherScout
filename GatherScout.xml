<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
  <!-- World map pin: item icon in a thin frame colored by difficulty for you; behaviour in GatherScoutMapPinMixin (Map.lua) -->
  <Frame name="GatherScoutMapPinTemplate" mixin="GatherScoutMapPinMixin" virtual="true" enableMouse="true">
    <Size x="12" y="12"/>
    <Layers>
      <Layer level="BACKGROUND">
        <Texture parentKey="Shadow">
          <Anchors>
            <Anchor point="TOPLEFT" x="-2" y="2"/>
            <Anchor point="BOTTOMRIGHT" x="2" y="-2"/>
          </Anchors>
          <Color r="0" g="0" b="0" a="0.55"/>
        </Texture>
      </Layer>
      <Layer level="BORDER">
        <Texture parentKey="Edge">
          <Anchors>
            <Anchor point="TOPLEFT" x="-1" y="1"/>
            <Anchor point="BOTTOMRIGHT" x="1" y="-1"/>
          </Anchors>
          <Color r="1" g="1" b="1" a="1"/>
        </Texture>
      </Layer>
      <Layer level="ARTWORK">
        <Texture parentKey="Texture" setAllPoints="true"/>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad method="OnLoad"/>
      <OnEnter method="OnMouseEnter"/>
      <OnLeave method="OnMouseLeave"/>
    </Scripts>
  </Frame>
</Ui>
